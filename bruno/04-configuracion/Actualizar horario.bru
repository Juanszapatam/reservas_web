meta {
  name: Actualizar horario
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/config/horario
  body: json
  auth: none
}

headers {
  cookie: {{cookieAdmin}}
}

body:json {
  {
    "diasLaborales": [1, 2, 3, 4, 5, 6],
    "apertura": "08:00",
    "cierre": "17:00",
    "zonaHoraria": "America/Bogota",
    "bloqueos": []
  }
}
