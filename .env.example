# Copia este archivo a .env.local y completa los valores reales.
# Nunca versiones .env.local ni claves privadas.

# Repositorio de datos: "memoria" | "firestore".
# Vacío = Firestore si hay credenciales o emulador; si no, memoria.
REPOSITORIO=

# Emuladores de Firebase (desarrollo y pruebas). Vacío en producción.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Emulador de Auth para el navegador (solo desarrollo), p. ej. 127.0.0.1:9099.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Configuración web de Firebase (pública por diseño)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
